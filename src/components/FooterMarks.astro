---
const basePath = import.meta.env.BASE_URL;
---

<div class="footer-marks">
  <span class="footer-marks__ownership">
    <span class="footer-marks__copyright">© th&amp;</span>
    <span class="footer-marks__year">2122</span>
  </span>
  <img class="footer-marks__mark footer-marks__mark--one" src={`${basePath}assets/footer/1.svg`} width="34" height="17" alt="" aria-hidden="true" />
  <img class="footer-marks__mark footer-marks__mark--two" src={`${basePath}assets/footer/2.svg`} width="34" height="17" alt="" aria-hidden="true" />
  <img class="footer-marks__mark footer-marks__mark--three" src={`${basePath}assets/footer/3.svg`} width="74" height="17" alt="" aria-hidden="true" />
</div>
