---
type LinkIconName = "email" | "telegram" | "external";

interface Props {
  name: LinkIconName;
}

const { name } = Astro.props;
---

<svg
  class="micro-link__icon"
  data-link-icon={name}
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === "email" ? (
      <>
        <rect x="2.25" y="3.25" width="11.5" height="9.5" rx="0.75" />
        <path d="m2.8 4.1 5.2 4.05 5.2-4.05" />
      </>
    ) : name === "telegram" ? (
      <>
        <path d="m13.75 2.25-2.1 11.5-4.2-4.5-4.2-2.05 10.3-4.95Z" />
        <path d="m7.45 9.25 2.15-2.45" />
      </>
    ) : (
      <>
        <path d="M5 3h8v8" />
        <path d="m13 3-9 9" />
      </>
    )
  }
</svg>
