---
import type { HomeProjectCard, Project } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  projects: readonly Project[];
  cards: readonly HomeProjectCard[];
}

const { projects, cards } = Astro.props;
const cardsWithProjects = cards.map((card) => {
  const project = projects.find(({ slug }) => slug === card.projectSlug);

  if (!project) {
    throw new Error(`Home card ${card.id} refers to an unknown project: ${card.projectSlug}`);
  }

  return { card, project };
});
---

<section class="project-grid" aria-label="Projects" data-testid="project-grid">
  {
    cardsWithProjects.length > 0 ? (
      cardsWithProjects.map(({ card, project }) => (
        <ProjectCard project={project} card={card} domSnapshotDisplacement={card.mediaStatus === "ready"} />
      ))
    ) : (
      <p class="visually-hidden" role="status">No projects are published yet.</p>
    )
  }
</section>
