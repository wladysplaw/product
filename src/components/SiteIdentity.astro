---
const portraitBasePath = `${import.meta.env.BASE_URL}assets/portrait/`;
---

<h1 class="site-identity">
  <span class="site-identity__visual" aria-hidden="true">
    <span class="site-identity__portrait" data-site-identity-portrait>
      <img class="site-identity__portrait-image site-identity__portrait-image--one" src={`${portraitBasePath}me01.png`} width="100" height="100" alt="" />
      <img class="site-identity__portrait-image site-identity__portrait-image--two" src={`${portraitBasePath}me02.png`} width="100" height="100" alt="" />
      <img class="site-identity__portrait-image site-identity__portrait-image--three" src={`${portraitBasePath}me03.png`} width="100" height="100" alt="" />
    </span>
    <span class="site-identity__name">Władysław</span><span> — </span>design digital products, from strategy<br />to deployment and beyond
  </span>
  <span class="visually-hidden">Władysław — design digital products, from strategy to deployment and beyond</span>
</h1>
<p class="site-identity__summary">
  <span class="site-identity__summary-visual" aria-hidden="true">work across product design, branding and digital experiences,<br class="site-identity__summary-desktop-break" /><span class="site-identity__summary-helping">helping businesses turn complex ideas into clear, meaningful and</span><br />effective products</span>
  <span class="visually-hidden">work across product design, branding and digital experiences, helping businesses turn complex ideas into clear, meaningful and effective products</span>
</p>
