---
import ProjectDetail from "../components/ProjectDetail.astro";
import { directProjects } from "../data/projects";
import { getProjectBySlug, getProjectNeighbors, getProjectPaths } from "../lib/projects";
import BaseLayout from "../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return getProjectPaths(directProjects);
}

const project = getProjectBySlug(Astro.params.slug ?? "", directProjects);

if (!project) {
  throw new Error("Direct project route rendered without a project record.");
}
---

<BaseLayout title={project.title} description={project.summary}>
  <ProjectDetail project={project} neighbors={getProjectNeighbors(project.slug, directProjects)} routePrefix="" />
</BaseLayout>
