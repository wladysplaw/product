---
import ProjectDetail from "../../components/ProjectDetail.astro";
import { allProjects, directProjects, projects } from "../../data/projects";
import { getProjectBySlug, getProjectNeighbors, getProjectPaths } from "../../lib/projects";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return getProjectPaths(allProjects);
}

const project = getProjectBySlug(Astro.params.slug ?? "", allProjects);

if (!project) {
  throw new Error("Project route rendered without a project record.");
}
---

<BaseLayout title={project.title} description={project.summary}>
  <ProjectDetail
    project={project}
    neighbors={getProjectNeighbors(
      project.slug,
      directProjects.some(({ slug }) => slug === project.slug) ? directProjects : projects
    )}
  />
</BaseLayout>
